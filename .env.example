# Copy to .env (never commit it). One secret per module, each at least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TELEGRAM_BOT_TOKEN=
# Same value as the Notion token of t6-sixto-watchdog. Used only to read and (later) write Contacts.
NOTION_API_KEY=
WATCHDOG_SECRET=
SHIFT_SECRET=                                 # JO shift reports (https://github.com/mclbautista/t6-sixto-gateway/issues/41)
