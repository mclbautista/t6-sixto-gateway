# Copy to .env (never commit it). One secret per module, each at least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TELEGRAM_BOT_TOKEN=
# Same value as the Notion token of t6-sixto-watchdog. Used only to read and (later) write Contacts.
NOTION_API_KEY=
# Telegram user ids allowed to send /project, space or comma separated. t6-core reads the same
# T6_OPERATOR_IDS, so operators are defined once.
T6_OPERATOR_IDS=
WATCHDOG_SECRET=
SHIFT_SECRET=                                 # JO shift reports (https://github.com/mclbautista/t6-sixto-gateway/issues/41)
NETOPS_SECRET=                                # t6-netops notifications (own secret, never the Telegram bot token)
T6CORE_SECRET=                                # t6-core webhooks server and Frame.io worker (README: "Messages from t6-core")

# The optional Tailscale sidecar's auth key is NOT here: it goes in .env.tailscale (see
# tailscale.env.example) so the gateway never sees it.
# Sidecar's host-side port binding. Keep loopback for the existing Colima mapping;
# use a specific LAN interface address if direct LAN publishing is required, never 0.0.0.0.
GATEWAY_BIND_IP=127.0.0.1
